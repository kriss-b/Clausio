# =========================================================================
#  Configuration de Clausio — copiez ce fichier en ".env" et renseignez-le.
#  Toutes ces valeurs peuvent aussi être passées en variables d'environnement.
# =========================================================================

# --- Fournisseur LLM (protocole OpenAI : /chat/completions, /embeddings) ---
# Clausio fonctionne avec tout service compatible OpenAI. Exemples ci-dessous :
# décommentez UN bloc.

# 1) Albert — plateforme souveraine de la DINUM (recommandé en établissement public)
CLAUSIO_LLM_BASE_URL=https://albert.api.etalab.gouv.fr/v1
CLAUSIO_LLM_API_KEY=VOTRE_CLE_ALBERT
# CLAUSIO_LLM_MODEL=            # vide = auto-détection
# CLAUSIO_LLM_EMBED_MODEL=      # vide = auto-détection du modèle d'embeddings

# 2) OpenAI
# CLAUSIO_LLM_BASE_URL=https://api.openai.com/v1
# CLAUSIO_LLM_API_KEY=sk-...
# CLAUSIO_LLM_MODEL=gpt-4o-mini
# CLAUSIO_LLM_EMBED_MODEL=text-embedding-3-small

# 3) Mistral
# CLAUSIO_LLM_BASE_URL=https://api.mistral.ai/v1
# CLAUSIO_LLM_API_KEY=...
# CLAUSIO_LLM_MODEL=mistral-small-latest
# CLAUSIO_LLM_EMBED_MODEL=mistral-embed

# 4) LLM LOCAL — Ollama (aucune clé requise)
#    Prérequis : `ollama pull llama3.1` et `ollama pull nomic-embed-text`
# CLAUSIO_LLM_BASE_URL=http://localhost:11434/v1
# CLAUSIO_LLM_API_KEY=
# CLAUSIO_LLM_MODEL=llama3.1
# CLAUSIO_LLM_EMBED_MODEL=nomic-embed-text

# 5) LLM LOCAL — vLLM / LM Studio / llama.cpp (serveur compatible OpenAI)
# CLAUSIO_LLM_BASE_URL=http://localhost:8000/v1
# CLAUSIO_LLM_API_KEY=
# CLAUSIO_LLM_MODEL=le-nom-du-modele-servi

# --- Application ----------------------------------------------------------
# Compte administrateur initial (créé au premier démarrage). À CHANGER.
CLAUSIO_USER=admin
CLAUSIO_PASSWORD=changez-moi
# Secret de session : mettez une longue chaîne aléatoire unique.
CLAUSIO_SESSION_SECRET=remplacez-par-une-chaine-aleatoire-longue

# --- Réseau (facultatif) --------------------------------------------------
# HOST=0.0.0.0
# PORT=3000
